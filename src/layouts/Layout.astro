---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  transparentHeader?: boolean;
  canonical?: string;
}

const { 
  title, 
  description = "Aluguel de Caçamba em Volta Redonda. Atendimento rápido e caçambas regularizadas.",
  image,
  type,
  transparentHeader = false,
  canonical
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Component -->
    <SEO title={title} description={description} image={image} type={type} canonical={canonical} />
    
    <!-- Schema Markup LocalBusiness -->
    <SchemaLocalBusiness />

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
    <!-- Header/Navigation -->
    <header class={`w-full z-50 transition-all duration-300 ${transparentHeader ? 'absolute top-0 bg-transparent border-b border-slate-200/50' : 'sticky top-0 bg-white/80 backdrop-blur-md border-b border-slate-200/80'}`}>
      <div class="container mx-auto px-6 md:px-12 h-24 flex justify-between items-center">
        <a href="/" class="text-[22px] font-black tracking-tight flex items-center gap-2 hover:scale-105 active:scale-95 transition-all text-slate-950">
          <svg class="h-[40px] w-[40px] text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
            <g transform="translate(12 12.5) scale(1.6) translate(-12 -12.5)">
              <path d="M7.5 10h9" stroke-width="2.2" stroke-linecap="round" />
              <path d="M8.25 10.5L9.5 15h5L15.75 10.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="10.6" y1="10.5" x2="11.25" y2="15" stroke-width="1.5" stroke-linecap="round" />
              <line x1="12" y1="10.5" x2="12" y2="15" stroke-width="1.5" stroke-linecap="round" />
              <line x1="13.4" y1="10.5" x2="12.75" y2="15" stroke-width="1.5" stroke-linecap="round" />
            </g>
          </svg>
          Caçambas VR
        </a>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:flex gap-8 text-base font-bold text-slate-950">
          <a href="/" class="hover:scale-105 active:scale-95 transition-all duration-200 inline-block hover:text-green-700">Início</a>
          <a href="/servicos" class="hover:scale-105 active:scale-95 transition-all duration-200 inline-block hover:text-green-700">Serviços</a>
          <a href="/blog" class="hover:scale-105 active:scale-95 transition-all duration-200 inline-block hover:text-green-700">Bairros de Atuação</a>
          <a href="/contato" class="hover:scale-105 active:scale-95 transition-all duration-200 inline-block hover:text-green-700">Contato</a>
          <a href="/sobre" class="hover:scale-105 active:scale-95 transition-all duration-200 inline-block hover:text-green-700">Sobre Nós</a>
        </nav>
        
        <!-- Desktop Call CTA -->
        <div class="hidden md:block">
          <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-green-600 hover:bg-green-500 text-white font-bold px-6 py-3 rounded-lg transition-all duration-200 text-sm shadow-md shadow-green-600/20 hover:shadow-green-600/40 hover:scale-105 active:scale-95 inline-block">
            Pedir Caçamba
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="menu-open" class="md:hidden focus:outline-none p-2 hover:scale-105 active:scale-95 transition-all text-slate-950" aria-label="Abrir Menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Menu Drawer (Solid Accent/Black bg with backdrop blur) -->
    <div id="mobile-menu" class="fixed inset-0 bg-accent/95 backdrop-blur-lg z-[999] flex flex-col justify-center items-center p-10 translate-x-full transition-transform duration-300 ease-in-out">
      <!-- Close Button -->
      <button id="menu-close" class="absolute top-6 right-6 text-white text-5xl p-2 hover:scale-105 active:scale-95 transition-all focus:outline-none" aria-label="Fechar Menu">
        &times;
      </button>
      
      <nav class="flex flex-col gap-6 text-2xl font-black tracking-tighter text-gray-100 mb-12 text-center">
        <a href="/" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all py-2 inline-block">Início</a>
        <a href="/servicos" class="hover:text-primary hover:scale-105 active:scale-95 transition-all py-2 inline-block">Serviços</a>
        <a href="/blog" class="hover:text-primary hover:scale-105 active:scale-95 transition-all py-2 inline-block">Bairros de Atuação</a>
        <a href="/contato" class="hover:text-primary hover:scale-105 active:scale-95 transition-all py-2 inline-block">Contato</a>
        <a href="/sobre" class="hover:text-primary hover:scale-105 active:scale-95 transition-all py-2 inline-block">Sobre</a>
      </nav>
      
      <div>
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-green-600 hover:bg-green-500 text-white font-black px-8 py-4 rounded-xl transition-all duration-200 text-base shadow-xl shadow-green-600/20 hover:scale-105 active:scale-95 inline-block">
          Chamar no WhatsApp
        </a>
      </div>
    </div>

    <!-- Main Content wrapper -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer (Contrast Polished) -->
    <footer class="border-t border-white/10 bg-secondary pt-24 pb-16 text-white text-sm">
      <div class="container mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          <div class="space-y-4">
            <p class="font-bold text-primary text-lg tracking-tight flex items-center gap-2">
              <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
                <g transform="translate(12 12.5) scale(1.6) translate(-12 -12.5)">
                  <path d="M7.5 10h9" stroke-width="2.2" stroke-linecap="round" />
                  <path d="M8.25 10.5L9.5 15h5L15.75 10.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="10.6" y1="10.5" x2="11.25" y2="15" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="12" y1="10.5" x2="12" y2="15" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="13.4" y1="10.5" x2="12.75" y2="15" stroke-width="1.5" stroke-linecap="round" />
                </g>
              </svg>
              {SITE_CONFIG.name}
            </p>
            <p class="max-w-xs text-white leading-relaxed">
              Serviço de aluguel de caçambas para entulho licenciado e sustentável em Volta Redonda e região.
            </p>
          </div>
          <div>
            <p class="font-bold text-primary text-sm uppercase tracking-wider mb-6">Links Rápidos</p>
            <ul class="space-y-3">
              <li><a href="/" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Início</a></li>
              <li><a href="/sobre" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Sobre Nós</a></li>
              <li><a href="/servicos" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Serviços</a></li>
              <li><a href="/blog" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Bairros de Atuação</a></li>
              <li><a href="/informacoes" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Informações Úteis</a></li>
              <li><a href="/contato" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Fale Conosco</a></li>
              <li><a href="/privacidade" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Política de Privacidade</a></li>
              <li><a href="/termos" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Termos de Locação</a></li>
            </ul>
          </div>
          <div>
            <p class="font-bold text-primary text-sm uppercase tracking-wider mb-6">Suporte & Logística</p>
            <ul class="space-y-3">
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">Fixo</span>
                <a href="tel:2430251234" class="text-white hover:text-primary transition-all duration-200">(24) 3025-1234</a>
              </li>
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">WhatsApp 24h</span>
                <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-white hover:text-primary transition-all duration-200">{SITE_CONFIG.whatsapp}</a>
              </li>
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">E-mail Comercial</span>
                <a href="mailto:contato@cacambasvr.com.br" class="text-white hover:text-primary transition-all duration-200">contato@cacambasvr.com.br</a>
              </li>
            </ul>
          </div>
          <div>
            <p class="font-bold text-primary text-sm uppercase tracking-wider mb-6">Operação & Meio Ambiente</p>
            <ul class="space-y-3">
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">Endereço</span>
                <span class="text-white">{SITE_CONFIG.address}</span>
              </li>
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">Licença SMMA</span>
                <span class="text-white">L.O. nº 0387/24</span>
              </li>
              <li>
                <span class="block text-xs text-gray-300 font-medium uppercase">Registro ATT</span>
                <span class="text-white">ATT-VR nº 092/24</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-900 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white">
          <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.</p>
        </div>
      </div>
    </footer>

    <!-- WhatsApp Floating Button -->
    <WhatsAppBtn />

    <!-- Mobile Menu Toggle Logic -->
    <script>
      const openBtn = document.getElementById('menu-open');
      const closeBtn = document.getElementById('menu-close');
      const menu = document.getElementById('mobile-menu');

      if (openBtn && closeBtn && menu) {
        openBtn.addEventListener('click', () => {
          menu.classList.remove('translate-x-full');
          document.body.style.overflow = 'hidden';
        });

        closeBtn.addEventListener('click', () => {
          menu.classList.add('translate-x-full');
          document.body.style.overflow = '';
        });

        // Close drawer and restore scroll when clicking any link
        const links = menu.querySelectorAll('nav a');
        links.forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('translate-x-full');
            document.body.style.overflow = '';
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Global styles and CSS Reset */
  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  
  /* UX Respiro & Container Base Rules */
  main section {
    @apply py-24 md:py-32;
  }
  
  main section > div {
    @apply container mx-auto px-6 md:px-12;
  }
</style>
