---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const servicoEntries = await getCollection('servicos');
  return servicoEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'servicos'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const specsBySlug = {
  'cacamba-4m': {
    altura: '1.20m',
    largura: '1.40m',
    comprimento: '2.50m',
    volume: '4m³',
    pesoSuportado: '4.5 Toneladas',
    permanencia: '3 a 7 dias',
    carrinhos: '80',
    latas: '220'
  },
  'cacamba-5m': {
    altura: '1.30m',
    largura: '1.50m',
    comprimento: '2.70m',
    volume: '5m³',
    pesoSuportado: '5.5 Toneladas',
    permanencia: '3 a 7 dias',
    carrinhos: '100',
    latas: '280'
  },
  'cacamba-7m': {
    altura: '1.50m',
    largura: '1.60m',
    comprimento: '3.20m',
    volume: '7m³',
    pesoSuportado: '7.5 Toneladas',
    permanencia: '3 a 7 dias',
    carrinhos: '140',
    latas: '380'
  },
  'cacamba-roll-on': {
    altura: '2.20m',
    largura: '2.40m',
    comprimento: '6.20m',
    volume: '26m³',
    pesoSuportado: '15.0 Toneladas',
    permanencia: 'Sob consulta',
    carrinhos: '520',
    latas: '1430'
  }
};

const specs = specsBySlug[entry.slug as keyof typeof specsBySlug];
---

<Layout title={`${entry.data.title} | ${SITE_CONFIG.name}`} description={entry.data.description}>
  <!-- Hero Header Section -->
  <section class="bg-secondary text-white py-16 md:py-24 relative overflow-hidden text-center">
    <div class="container mx-auto px-6 md:px-12 relative z-10">
      <div class="max-w-3xl mx-auto space-y-6">
        <a href="/servicos" class="bg-white/10 hover:bg-white/20 text-white font-bold text-xs md:text-sm px-4 py-2 rounded-full inline-flex items-center gap-2 border border-white/20 transition-all hover:scale-105 active:scale-95">
          &larr; Voltar para Serviços
        </a>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tighter leading-tight">
          {entry.data.title}
        </h1>
        <p class="text-sm md:text-lg text-green-100 max-w-2xl mx-auto font-medium leading-relaxed">
          {entry.data.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Content & Specifications Grid -->
  <section class="bg-white border-b border-slate-100 !py-12 md:!py-16">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
        
        <!-- Left Column: Main Content (2/3 width) -->
        <div class="lg:col-span-2 space-y-12">
          
          {entry.data.image && (
            <img src={entry.data.image} alt={entry.data.title} class="w-full aspect-[21/9] object-cover rounded-3xl shadow-lg border border-slate-200/40" />
          )}
          
          <!-- Descrição Completa -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-1.5 h-8 bg-primary rounded-full"></div>
              <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Descrição Completa</h2>
            </div>
            
            <article class="prose prose-lg prose-slate max-w-none">
              <Content />
            </article>
          </div>

          <!-- Especificações Técnicas (Middle of Content) -->
          {specs && (
            <div class="space-y-6 pt-6 border-t border-slate-100">
              <h3 class="text-2xl font-black text-slate-900 tracking-tight">Especificações Técnicas</h3>
              
              <div class="bg-white border border-slate-200/60 p-8 md:p-10 rounded-3xl shadow-sm">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-8 gap-x-6">
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Altura</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.altura}</span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Largura</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.largura}</span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Comprimento</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.comprimento}</span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Volume</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.volume}</span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Peso Suportado</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.pesoSuportado}</span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Capacidade</span>
                    <span class="text-lg sm:text-xl font-extrabold text-slate-950">{specs.latas} Latas</span>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Highlight Badges Section (Bottom of Content) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6 border-t border-slate-100">
            <!-- Highlight 1: Licenciamento / Higienização -->
            <div class="bg-green-50/50 border border-green-100 p-6 rounded-2xl flex items-start gap-4 shadow-sm">
              <div class="bg-green-100 text-green-600 p-3 rounded-xl flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h4 class="font-bold text-slate-900 text-base">Descarte 100% Legalizado</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Emitimos MTR e possuímos licença ambiental completa (SMMA/ATT) para descarte ecologicamente correto.
                </p>
              </div>
            </div>

            <!-- Highlight 2: Entrega Rápida -->
            <div class="bg-amber-50/50 border border-amber-100 p-6 rounded-2xl flex items-start gap-4 shadow-sm">
              <div class="bg-amber-100 text-amber-600 p-3 rounded-xl flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h4 class="font-bold text-slate-900 text-base">Entrega Ágil no Local</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Frota própria e logística inteligente para entregar e retirar sua caçamba com máxima pontualidade.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Sidebar (1/3 width, sticky) -->
        <div class="lg:col-span-1 lg:sticky lg:top-24 space-y-6">
          <div class="bg-secondary text-white p-8 md:p-10 rounded-3xl shadow-2xl shadow-secondary/30 flex flex-col gap-6 text-center border border-white/10">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-primary">Orçamento Gratuito</span>
              <h3 class="text-xl font-black text-white mt-2">Interessado neste modelo?</h3>
            </div>
            
            <div class="flex flex-col gap-3">
              <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-yellow-500 text-slate-950 font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition-all hover:scale-[1.03] active:scale-[0.97] text-sm shadow-md shadow-primary/20">
                💬 Pedir no WhatsApp
              </a>
              <a href={`tel:${SITE_CONFIG.phoneFormatted}`} class="border border-white/30 hover:border-white text-white font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition-all hover:scale-[1.03] active:scale-[0.97] text-sm">
                📞 Ligar Agora
              </a>
            </div>
            
            <div class="pt-4 border-t border-white/10 text-center">
              <p class="text-xs text-white/80 font-medium">Dúvidas? Fale com um especialista.</p>
              <a href={`tel:${SITE_CONFIG.phoneFormatted}`} class="text-lg font-black text-white mt-1 block hover:underline">
                {SITE_CONFIG.phone}
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* Custom characteristics list wrapper */
  article.prose ul {
    list-style: none !important;
    padding: 2rem !important;
    background-color: #ffffff;
    border: 1px solid #f1f5f9; /* border-slate-100 */
    border-radius: 1.5rem; /* rounded-3xl */
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05); /* shadow-md */
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem !important;
    margin-bottom: 2rem !important;
  }
  
  @media (min-width: 640px) {
    article.prose ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  article.prose li {
    position: relative;
    padding-left: 2.25rem !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    font-size: 0.95rem;
    color: #334155; /* text-slate-700 */
    font-weight: 500;
  }

  article.prose li::before {
    content: "✓" !important;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1.5rem;
    height: 1.5rem;
    background-color: #d1fae5; /* bg-green-100 */
    color: #059669; /* text-green-600 */
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
  }
</style>
