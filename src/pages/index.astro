---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_CONFIG } from '../data/config';

const servicos: CollectionEntry<'servicos'>[] = await getCollection('servicos');
const showcaseServicos = servicos.slice(0, 6);

const depoimentos = [
  {
    texto: 'Precisava de uma caçamba urgente para uma reforma no meu comércio no Aterrado. A entrega e a retirada foram pontuais e o motorista estacionou sem atrapalhar a rua.',
    nome: 'Carlos Eduardo',
    contexto: 'Comerciante do Aterrado',
    imagem: '/images/carlos.jpg',
  },
  {
    texto: 'Aluguei para retirar galhos, folhas e telhas quebradas do quintal. Fui muito bem atendida pelo WhatsApp e recolheram tudo no dia combinado.',
    nome: 'Sônia Regina',
    contexto: 'Moradora do bairro Água Limpa',
    imagem: '/images/sonia.jpg',
  },
  {
    texto: 'Trabalho com reformas e a pontualidade na troca das caçambas é fundamental. A equipe também fornece o comprovante de descarte legalizado que os condomínios exigem.',
    nome: 'Roberto Figueiredo',
    contexto: 'Profissional de obras na Vila Santa Cecília',
    imagem: '/images/roberto.jpg',
  },
];

const diferenciais = [
  { icone: '⚡', titulo: 'Agendamento rápido', texto: 'Atendimento direto pelo WhatsApp para combinar entrega, troca e retirada.' },
  { icone: '✓', titulo: 'Operação regularizada', texto: 'Caçambas adequadas e destinação responsável dos resíduos da sua obra.' },
  { icone: '↗', titulo: 'Atendimento em Volta Redonda', texto: 'Logística local para residências, comércios, condomínios e canteiros de obras.' },
  { icone: 'R$', titulo: 'Orçamento sem compromisso', texto: 'Condições claras de acordo com o volume, o endereço e o período de locação.' },
];
---

<Layout
  transparentHeader={true}
  title="Disk Caçamba para Entulho em Volta Redonda | DiskCaçamba"
  description="Reserve sua caçamba para obra em Volta Redonda com atendimento ágil, entrega programada e retirada responsável de entulho. Solicite seu orçamento pelo WhatsApp."
>
  <section class="overflow-hidden border-b border-slate-200/60 bg-slate-50 !pt-24 pb-16 md:!pt-32 md:pb-24">
    <div>
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="z-10 flex flex-col items-start text-left">
          <span class="mb-6 inline-flex rounded-full border border-green-700/20 bg-green-50 px-5 py-2 text-sm font-extrabold uppercase tracking-wider text-green-800">
            Atendimento local para obras e reformas
          </span>
          <h1 class="mb-6 text-4xl font-black leading-[1.08] tracking-tighter text-gray-950 sm:text-5xl md:text-6xl">
            Disk Caçamba para Entulho em <span class="text-green-700">Volta Redonda</span>
          </h1>
          <p class="mb-8 max-w-xl text-lg leading-relaxed text-gray-600 md:text-xl">
            Precisa liberar espaço na obra? Agende uma caçamba pelo WhatsApp e combine a entrega e a retirada no endereço desejado.
          </p>
          <div class="flex w-full flex-wrap gap-4 sm:w-auto">
            <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-full rounded-xl bg-green-700 px-8 py-4 text-center text-lg font-black text-white shadow-xl shadow-green-700/20 transition hover:-translate-y-0.5 hover:bg-green-600 sm:w-auto">
              Solicitar orçamento
            </a>
            <a href="/servicos" class="w-full rounded-xl border border-slate-300 bg-white px-8 py-4 text-center text-lg font-bold text-gray-900 shadow-sm transition hover:border-green-700 hover:text-green-800 sm:w-auto">
              Escolher caçamba
            </a>
          </div>
        </div>
        <div class="relative mx-auto aspect-[4/3.5] w-full max-w-lg overflow-hidden rounded-[2rem] shadow-2xl">
          <img src="/images/hero-cacamba.jpg" alt="Caçamba para retirada de entulho de obra em Volta Redonda" class="h-full w-full object-cover object-center transition duration-700 hover:scale-105" />
        </div>
      </div>
    </div>
  </section>

  <!-- Depoimentos aparecem imediatamente após a Hero para alterar a hierarquia da página. -->
  <section class="border-b border-slate-800 bg-slate-950 text-white">
    <div>
      <div class="mb-12 max-w-2xl">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[0.2em] text-lime-300">Experiências reais</span>
        <h2 class="text-3xl font-black tracking-tight md:text-5xl">Quem reforma recomenda</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {depoimentos.map((depoimento) => (
          <article class="flex h-full flex-col justify-between rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur-sm">
            <div>
              <div class="mb-5 text-lg tracking-widest text-lime-300" aria-label="5 de 5 estrelas">★★★★★</div>
              <blockquote class="leading-relaxed text-slate-200">“{depoimento.texto}”</blockquote>
            </div>
            <div class="mt-7 flex items-center gap-3 border-t border-white/10 pt-5">
              <img src={depoimento.imagem} alt={depoimento.nome} class="h-12 w-12 rounded-full object-cover ring-2 ring-lime-300/60" />
              <div>
                <p class="font-bold text-white">{depoimento.nome}</p>
                <p class="text-sm text-slate-400">{depoimento.contexto}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div>
      <div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="mb-3 block text-sm font-bold uppercase tracking-[0.2em] text-green-700">Soluções para cada volume</span>
          <h2 class="text-3xl font-black tracking-tight text-gray-950 md:text-5xl">Caçambas para sua obra</h2>
        </div>
        <a href="/servicos" class="font-bold text-green-800 underline decoration-green-300 decoration-2 underline-offset-4">Ver todos os serviços</a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {showcaseServicos.map((servico) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm transition hover:border-green-700/30 hover:shadow-lg sm:flex-row">
            {servico.data.image && (
              <img src={servico.data.image} alt={servico.data.title} class="aspect-[16/10] w-full object-cover sm:aspect-auto sm:w-44" />
            )}
            <div class="flex flex-1 flex-col justify-between p-6">
              <div>
                <h3 class="mb-2 text-xl font-black text-gray-950">{servico.data.title}</h3>
                <p class="mb-5 text-sm leading-relaxed text-gray-600">{servico.data.description}</p>
              </div>
              <a href={`/servicos/${servico.slug}`} class="text-sm font-extrabold text-green-800 transition group-hover:translate-x-1">Consultar detalhes →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div>
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-[0.2em] text-green-700">Por que chamar a DiskCaçamba</span>
          <h2 class="mb-8 text-3xl font-black tracking-tight text-gray-950 md:text-5xl">Serviço pensado para não parar sua obra</h2>
          <div class="flex flex-col gap-6">
            {diferenciais.map((item) => (
              <div class="flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-green-800 text-sm font-black text-white">{item.icone}</span>
                <div>
                  <h3 class="mb-1 text-lg font-extrabold text-gray-950">{item.titulo}</h3>
                  <p class="text-sm leading-relaxed text-gray-600">{item.texto}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-lime-200/50"></div>
          <img src="/images/team-cacamba.jpg" alt="Equipe responsável pela entrega e retirada de caçambas" class="aspect-[4/5] w-full rounded-[2rem] object-cover shadow-xl" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-green-900 text-white">
    <div>
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <h2 class="mb-4 text-3xl font-black tracking-tight md:text-5xl">Tem entulho acumulado na obra?</h2>
          <p class="max-w-2xl text-lg leading-relaxed text-green-100">Informe o bairro, o tipo de resíduo e o volume aproximado. Nossa equipe orienta sobre a caçamba adequada.</p>
        </div>
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-lime-300 px-8 py-4 text-center text-lg font-black text-green-950 transition hover:bg-lime-200">Falar com a equipe</a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white" aria-labelledby="faq-title">
    <div>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-[0.2em] text-green-700">Tire suas dúvidas</span>
          <h2 id="faq-title" class="text-3xl font-black tracking-tight text-gray-950 md:text-5xl">Perguntas Frequentes sobre Disk Caçamba</h2>
        </div>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          <article class="py-6">
            <h3 class="mb-3 text-xl font-extrabold text-gray-950">Qual o valor do disk caçamba em Volta Redonda?</h3>
            <p class="leading-relaxed text-gray-600">O preço depende do tamanho da caçamba, do bairro de entrega, do tipo de resíduo e do período de permanência. Envie esses dados pelo WhatsApp para receber um orçamento.</p>
          </article>
          <article class="py-6">
            <h3 class="mb-3 text-xl font-extrabold text-gray-950">Como funciona a retirada de entulho da obra?</h3>
            <p class="leading-relaxed text-gray-600">A equipe entrega a caçamba no local combinado e programa a retirada após o período contratado. Os resíduos devem respeitar as orientações informadas no atendimento.</p>
          </article>
          <article class="py-6">
            <h3 class="mb-3 text-xl font-extrabold text-gray-950">Quanto tempo a caçamba pode ficar no endereço?</h3>
            <p class="leading-relaxed text-gray-600">O prazo é definido no orçamento e pode variar conforme a demanda e as regras aplicáveis ao local. Consulte a disponibilidade para a data da sua obra.</p>
          </article>
          <article class="py-6">
            <h3 class="mb-3 text-xl font-extrabold text-gray-950">Quais materiais podem ser colocados na caçamba?</h3>
            <p class="leading-relaxed text-gray-600">Entulho de construção, concreto, tijolos e outros resíduos de obra podem ser aceitos. Materiais perigosos, hospitalares ou inflamáveis exigem destinação específica e não devem ser misturados.</p>
          </article>
        </div>
      </div>
    </div>
  </section>
</Layout>
