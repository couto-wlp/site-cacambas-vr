---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const infoEntries = await getCollection('informacoes');
  return infoEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'informacoes'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const bairro = entry.data.bairro || "Volta Redonda";
const servicos = (await getCollection('servicos')).filter(item => item.slug.startsWith('cacamba-'));
---

<Layout title={`${entry.data.title}`} description={entry.data.description}>
  <section class="bg-white py-12 md:py-16">
    <div>
      <div class="max-w-7xl mx-auto px-6">
        <!-- Back Link -->
        <a href="/informacoes" class="text-secondary font-bold text-sm mb-6 inline-block hover:underline hover:scale-105 active:scale-95 transition-all">&larr; Voltar para Informações Úteis</a>
        
        <!-- Page Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">
          {entry.data.title.split(' | ')[0]}
        </h1>
        <p class="text-base md:text-lg text-gray-600 mb-8 leading-relaxed">
          {entry.data.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 mb-12">
          <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-yellow-500 text-slate-950 font-black px-6 py-3.5 rounded-xl transition-all duration-200 text-sm shadow-md hover:scale-105 active:scale-95">
            Orçamento no WhatsApp
          </a>
          <a href="/servicos" class="border border-slate-300 hover:border-slate-400 bg-white hover:bg-slate-50 text-gray-900 font-bold px-6 py-3.5 rounded-xl transition-all duration-200 text-sm hover:scale-105 active:scale-95">
            Ver Caçambas
          </a>
        </div>

        <!-- Features Section (The 3 Cards) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <div class="bg-slate-50 border border-slate-200/60 p-6 rounded-2xl flex items-start gap-4">
            <span class="text-2xl text-primary bg-primary/10 p-2 rounded-xl">⚡</span>
            <div>
              <h3 class="font-bold text-gray-900 text-sm mb-1">Logística Expressa</h3>
              <p class="text-gray-600 text-xs leading-relaxed">
                Entrega e remoção rápidas e pontuais em toda Volta Redonda, respeitando o cronograma de sua construção ou reforma.
              </p>
            </div>
          </div>
          <div class="bg-slate-50 border border-slate-200/60 p-6 rounded-2xl flex items-start gap-4">
            <span class="text-2xl text-secondary bg-secondary/10 p-2 rounded-xl">📋</span>
            <div>
              <h3 class="font-bold text-gray-900 text-sm mb-1">Descarte 100% Legal</h3>
              <p class="text-gray-600 text-xs leading-relaxed">
                Emissão completa de MTR e conformidade total com as normas da Secretaria Municipal de Meio Ambiente (SMMA) de Volta Redonda.
              </p>
            </div>
          </div>
          <div class="bg-slate-50 border border-slate-200/60 p-6 rounded-2xl flex items-start gap-4">
            <span class="text-2xl text-blue-500 bg-blue-500/10 p-2 rounded-xl">🛡️</span>
            <div>
              <h3 class="font-bold text-gray-900 text-sm mb-1">Posicionamento Seguro</h3>
              <p class="text-gray-600 text-xs leading-relaxed">
                Motoristas experientes que posicionam a caçamba de forma regularizada na rua ou calçada de sua obra em Volta Redonda.
              </p>
            </div>
          </div>
        </div>

        <!-- Grid for Content + Sidebar -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start border-t border-slate-100 pt-12">
          <!-- Main Text Column (Left) -->
          <div class="lg:col-span-2 space-y-8">
            {entry.data.image && (
              <img src={entry.data.image} alt={entry.data.title} class="w-full aspect-[21/9] object-cover rounded-3xl shadow-lg border border-slate-200/40 mb-8" />
            )}
            <article class="prose prose-lg prose-slate max-w-none text-slate-700 prose-headings:text-gray-900 prose-headings:font-black prose-headings:tracking-tight prose-a:text-secondary hover:prose-a:text-secondary/80">
              <Content />
            </article>
          </div>

          <!-- Sidebar Column (Right) -->
          <div class="lg:col-span-1 lg:sticky lg:top-28">
            <div class="bg-secondary text-white p-8 rounded-2xl shadow-xl text-center space-y-6 border border-white/10 transition-all duration-300">
              <span class="text-xs font-bold uppercase tracking-wider text-primary">Orçamento Rápido</span>
              <h3 class="text-xl font-black tracking-tight leading-tight">Solicite agora seu orçamento no WhatsApp!</h3>
              <p class="text-green-100 text-sm leading-relaxed">
                Temos caçambas estacionárias prontas para atender sua reforma ou obra em Volta Redonda.
              </p>
              <div class="space-y-3">
                <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="block w-full bg-primary hover:bg-yellow-500 text-slate-950 font-black py-3.5 rounded-xl transition-all duration-200 text-sm shadow-md hover:scale-105 active:scale-95">
                  Chamar no WhatsApp
                </a>
                <a href={`tel:${SITE_CONFIG.phoneFormatted}`} class="block w-full border border-white/20 hover:border-white text-white font-bold py-3.5 rounded-xl transition-all duration-200 text-sm hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  Ligar Agora
                </a>
              </div>
              <div class="pt-2 border-t border-white/10">
                <p class="text-xs text-green-200">Ou nos ligue diretamente:</p>
                <p class="text-lg font-bold text-primary mt-1">{SITE_CONFIG.phone}</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Modelos de Caçamba Section -->
  <section class="bg-white border-t border-slate-100 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6 space-y-12">
      <div class="text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-secondary bg-secondary/5 px-3 py-1 rounded">Nossos Modelos</span>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 tracking-tight mt-3">Modelos de Caçamba</h2>
        <p class="text-gray-600 text-sm max-w-2xl mx-auto mt-2">
          Disponibilizamos caçambas estacionárias em diferentes tamanhos para atender a sua reforma em Volta Redonda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicos.map((servico) => (
          <div class="bg-slate-50 border-[0.5px] border-slate-200/30 p-8 rounded-2xl flex flex-col justify-between hover:shadow-xl transition-all duration-300">
            <div>
              {servico.data.image ? (
                <img src={servico.data.image} alt={servico.data.title} class="w-full aspect-[4/3] object-cover rounded-xl mb-6 shadow-sm border border-slate-200/30" />
              ) : (
                <div class="bg-primary/20 w-14 h-14 rounded-2xl flex items-center justify-center text-2xl mb-6">
                  {servico.data.icon || "🏗️"}
                </div>
              )}
              <h3 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-4">{servico.data.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">{servico.data.description}</p>
            </div>
            <div>
              <a href={`/servicos/${servico.slug}`} class="inline-block bg-secondary hover:bg-secondary/95 text-white text-xs font-bold px-6 py-3 rounded-lg transition-colors">
                Saiba Mais Detalhes
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (Accordion) -->
  <section class="bg-slate-50 border-t border-b border-slate-100 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6 space-y-12">
      <div class="text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-secondary bg-secondary/5 px-3 py-1 rounded">Dúvidas Comuns</span>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 tracking-tight mt-3">Perguntas Frequentes</h2>
      </div>

      <div class="space-y-4">
        <!-- Item 1 -->
        <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold text-gray-900 cursor-pointer list-none text-base md:text-lg">
            <span>Quanto tempo a caçamba pode permanecer na rua?</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
            <p>Em Volta Redonda, o período máximo regulamentado para permanência de caçambas estacionadas na via pública é de 3 a 5 dias. Em áreas privadas ou internas ao lote, o período pode ser flexibilizado de acordo com o contrato.</p>
          </div>
        </details>

        <!-- Item 2 -->
        <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold text-gray-900 cursor-pointer list-none text-base md:text-lg">
            <span>O que pode descartar na caçamba?</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
            <p>As caçambas são destinadas exclusivamente a resíduos da construção civil (tijolos, blocos, concreto, reboco, terra) e materiais inertes. É proibido descartar lixo orgânico, resíduos hospitalares, inflamáveis ou químicos.</p>
          </div>
        </details>

        <!-- Item 3 -->
        <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold text-gray-900 cursor-pointer list-none text-base md:text-lg">
            <span>A caçamba é legalizada? Como funciona o descarte?</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
            <p>Sim! Todas as nossas caçambas são cadastradas e fiscalizadas pela Prefeitura e órgãos ambientais. O descarte é feito em aterros autorizados de inertes (ATT), gerando o comprovante de descarte final (MTR).</p>
          </div>
        </details>

        <!-- Item 4 -->
        <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold text-gray-900 cursor-pointer list-none text-base md:text-lg">
            <span>Como é feito o pagamento do aluguel da caçamba?</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
            <p>Oferecemos facilidade de pagamento. Você pode pagar via Pix, transferência bancária, boleto ou parcelar no cartão de crédito diretamente com a nossa equipe.</p>
          </div>
        </details>

        <!-- Item 5 -->
        <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold text-gray-900 cursor-pointer list-none text-base md:text-lg">
            <span>Vocês entregam a caçamba no mesmo dia da contratação?</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
            <p>Sim! Temos frota própria e equipe de logística local em Volta Redonda. Se a contratação for feita dentro do horário comercial, entregamos a caçamba no mesmo dia, geralmente em até 2 horas conforme a disponibilidade da nossa frota.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Section -->
  <section class="bg-white border-t border-slate-100 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
      <h2 class="text-3xl md:text-4xl font-black text-gray-900 tracking-tight">Solicite sua caçamba em Volta Redonda</h2>
      <p class="text-gray-600 text-base leading-relaxed max-w-2xl mx-auto">
        Agendamento simples e rápido pelo celular. Receba e pague no local com facilidade.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-4">
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-yellow-500 text-slate-950 font-black px-8 py-4 rounded-xl transition-all duration-200 text-base shadow-lg hover:scale-105 active:scale-95 inline-block">
          Conversar no WhatsApp
        </a>
        <a href={`tel:${SITE_CONFIG.phoneFormatted}`} class="border border-slate-300 hover:border-slate-400 bg-white hover:bg-slate-50 text-gray-900 font-bold px-8 py-4 rounded-xl transition-all duration-200 text-base hover:scale-105 active:scale-95 inline-block">
          Ligar para {SITE_CONFIG.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
