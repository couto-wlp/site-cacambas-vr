---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_CONFIG } from '../data/config';

const servicos: CollectionEntry<'servicos'>[] = await getCollection('servicos');
---

<Layout title="Serviços | CAÇAMBA VR" description="Conheça as opções de aluguel de caçambas estacionárias oferecidas pela Caçamba VR em Volta Redonda. Escolha o tamanho ideal para sua obra.">
  <section class="bg-secondary text-white !py-12 md:!py-16">
    <div>
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-primary/20 border border-primary/30 text-primary font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wider mb-6">
          Locação de Caçambas
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-6">
          Serviços
        </h1>
        <p class="text-lg md:text-xl text-green-100 leading-relaxed max-w-3xl mx-auto">
          Temos caçambas de 4m³, 5m³, 7m³ e Roll-on/Roll-off para atender obras de todos os portes com soluções eficientes e licenciadas.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {servicos.map((servico) => (
          <div class="bg-slate-50 border-[0.5px] border-slate-200/30 p-6 rounded-2xl flex flex-col justify-between hover:shadow-xl transition-all duration-300">
            <div>
              {servico.data.image ? (
                <img src={servico.data.image} alt={servico.data.title} class="w-full aspect-[16/10] object-cover rounded-xl mb-6 shadow-sm border border-slate-200/30" />
              ) : (
                <div class="bg-primary/20 w-14 h-14 rounded-2xl flex items-center justify-center text-2xl mb-6">
                  {servico.data.icon || "🏗️"}
                </div>
              )}
              <h2 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-4">{servico.data.title}</h2>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">{servico.data.description}</p>
            </div>
            <div>
              <a href={`/servicos/${servico.slug}`} class="inline-block bg-secondary hover:bg-secondary/95 text-white text-xs font-bold px-6 py-3 rounded-lg transition-colors">
                Saiba Mais Detalhes
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
