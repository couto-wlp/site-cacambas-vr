---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Alphabetical sort for sidebar menu
const alphabeticalPosts = [...posts].sort((a, b) => {
  const nameA = a.data.bairro || a.data.title;
  const nameB = b.data.bairro || b.data.title;
  return nameA.localeCompare(nameB, 'pt-BR');
});
---

<Layout title="Bairros de Atuação | CAÇAMBA VR" description="Confira os principais bairros atendidos pelo aluguel de caçambas estacionárias em Volta Redonda - RJ.">
  <section class="bg-secondary text-white !py-12 md:!py-16">
    <div>
      <div class="max-w-7xl mx-auto text-center">
        <span class="inline-block bg-primary/20 border border-primary/30 text-primary font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wider mb-6">
          Área de Cobertura
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-6">
          Bairros de Atuação
        </h1>
        <p class="text-lg md:text-xl text-green-100 leading-relaxed max-w-3xl mx-auto">
          Confira as principais regiões e bairros atendidos pelo aluguel de caçambas em Volta Redonda.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div>
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 items-start">
          
          <!-- Left Column: Bairros Atendidos Sidebar Menu -->
          <div class="lg:col-span-1 lg:sticky lg:top-24">
            <div class="bg-slate-50 border-[0.5px] border-slate-200/30 rounded-3xl p-6 shadow-sm">
              <!-- Header -->
              <div class="flex items-center gap-3 font-extrabold text-slate-900 text-lg mb-4 pb-4 border-b border-slate-200/50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                Bairros Atendidos
              </div>

              <!-- List container (scrollable) -->
              <div class="max-h-[450px] overflow-y-auto pr-1 space-y-1 scrollbar-thin scrollbar-thumb-slate-200">
                {alphabeticalPosts.map((post) => (
                  <a href={`/blog/${post.slug}`} class="flex justify-between items-center py-3 px-4 rounded-xl text-slate-700 hover:text-secondary hover:bg-white transition-all font-semibold text-sm border-b border-slate-200/10 last:border-0">
                    <span>{post.data.bairro || post.data.title}</span>
                    <span class="text-slate-400 font-light">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Right Column: Neighborhood Cards Grid -->
          <div class="lg:col-span-3">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {posts.map((post) => (
                <div class="bg-slate-50 border-[0.5px] border-slate-200/30 p-8 rounded-2xl flex flex-col justify-between hover:shadow-xl transition-all duration-300">
                  <div>
                    <span class="text-xs text-gray-500 font-semibold block mb-3">
                      Atendimento em Volta Redonda
                    </span>
                    <h2 class="text-xl font-bold text-gray-900 mb-3">{post.data.title}</h2>
                    <p class="text-gray-600 text-xs leading-relaxed mb-6">{post.data.description}</p>
                  </div>
                  <div>
                    <a href={`/blog/${post.slug}`} class="inline-block text-secondary font-bold hover:text-secondary/80 text-sm">
                      Ver Detalhes do Bairro &rarr;
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</Layout>
