---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const articles: CollectionEntry<'informacoes'>[] = (await getCollection('informacoes')).sort(
  (a: CollectionEntry<'informacoes'>, b: CollectionEntry<'informacoes'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const alphabeticalArticles = [...articles].sort((a, b) => {
  return a.data.title.localeCompare(b.data.title, 'pt-BR');
});
---

<Layout title="Informações Úteis | CAÇAMBA VR" description="Confira guias, dicas e informações importantes para o aluguel de caçambas e descarte de entulho em Volta Redonda - RJ.">
  <section class="bg-secondary text-white !py-12 md:!py-16">
    <div>
      <div class="max-w-7xl mx-auto text-center">
        <span class="inline-block bg-primary/20 border border-primary/30 text-primary font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wider mb-6">
          Central de Informação
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-6">
          Informações Úteis
        </h1>
        <p class="text-lg md:text-xl text-green-100 leading-relaxed max-w-3xl mx-auto">
          Guias completos, regras de descarte e legislação para locação de caçambas em Volta Redonda.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div>
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 items-start">
          
          <!-- Left Column: Artigos Recentes Sidebar Menu -->
          <div class="lg:col-span-1 lg:sticky lg:top-24">
            <div class="bg-slate-50 border-[0.5px] border-slate-200/30 rounded-3xl p-6 shadow-sm">
              <!-- Header -->
              <div class="flex items-center gap-2 font-extrabold text-slate-900 text-sm sm:text-base mb-4 pb-4 border-b border-slate-200/50 whitespace-nowrap">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <span>Artigos Disponíveis</span>
              </div>

              <!-- List container -->
              <div class="space-y-1">
                {alphabeticalArticles.map((art) => (
                  <a href={`/informacoes/${art.slug}`} class="flex justify-between items-center py-3 px-4 rounded-xl text-slate-700 hover:text-secondary hover:bg-white transition-all font-semibold text-sm border-b border-slate-200/10 last:border-0">
                    <span>{art.data.title.split(' | ')[0]}</span>
                    <span class="text-slate-400 font-light">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Right Column: Articles Grid -->
          <div class="lg:col-span-3">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {articles.map((art) => (
                <div class="bg-slate-50 border-[0.5px] border-slate-200/30 p-8 rounded-2xl flex flex-col justify-between hover:shadow-xl transition-all duration-300">
                  <div>
                    <span class="text-xs text-gray-500 font-semibold block mb-3">
                      Dicas e Legislação
                    </span>
                    <h2 class="text-xl font-bold text-gray-900 mb-3">{art.data.title.split(' | ')[0]}</h2>
                    <p class="text-gray-600 text-xs leading-relaxed mb-6">{art.data.description}</p>
                  </div>
                  <div>
                    <a href={`/informacoes/${art.slug}`} class="inline-block text-secondary font-bold hover:text-secondary/80 text-sm">
                      Ler Artigo Completo &rarr;
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</Layout>
